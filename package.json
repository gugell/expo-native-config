{
  "name": "expo-native-config-repo",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm --filter expo-native-config build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter expo-native-config test",
    "lint": "eslint packages/expo-native-config/src packages/expo-native-config/tests scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "pack:check": "node scripts/pack-check.mjs",
    "examples:check": "node scripts/verify-examples.mjs",
    "release": "./scripts/release.sh",
    "release:dry-run": "./scripts/release.sh --dry-run",
    "native:check": "node scripts/verify-native.mjs",
    "android:check": "node scripts/verify-android.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@release-it/bumper": "^7.0.5",
    "@release-it/conventional-changelog": "^11.0.1",
    "cross-spawn": "^7.0.6",
    "eslint": "^10.10.0",
    "prettier": "^3.6.2",
    "release-it": "20.2.1",
    "typescript-eslint": "^8.70.0"
  },
  "version": "0.1.0",
  "release-it": {
    "npm": {
      "publish": false
    },
    "git": {
      "requireBranch": "main",
      "requireUpstream": true,
      "requireCleanWorkingDir": false,
      "commitMessage": "chore: release v${version}",
      "tagName": "v${version}",
      "addUntrackedFiles": true
    },
    "github": {
      "release": true,
      "releaseName": "v${version}"
    },
    "plugins": {
      "@release-it/bumper": {
        "out": [
          {
            "file": "packages/expo-native-config/package.json",
            "path": "version"
          }
        ]
      },
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "conventionalcommits",
          "types": [
            {
              "type": "feat",
              "section": "Features"
            },
            {
              "type": "fix",
              "section": "Bug Fixes"
            },
            {
              "type": "perf",
              "section": "Performance"
            },
            {
              "type": "docs",
              "section": "Documentation"
            },
            {
              "type": "chore(deps)",
              "section": "Dependencies"
            }
          ]
        },
        "infile": "packages/expo-native-config/CHANGELOG.md"
      }
    }
  }
}
