{
  "$schema": "https://unpkg.com/release-it@20/schema/release-it.json",
  "git": {
    "requireBranch": "main",
    "requireCleanWorkingDir": true,
    "requireUpstream": true,
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}",
    "addUntrackedFiles": true
  },
  "npm": {
    "publish": true,
    "publishPath": "../../artifacts/release/expo-native-workspace.tgz",
    "publishPackageManager": "npm",
    "publishArgs": ["--access", "public"]
  },
  "github": {
    "release": true,
    "releaseName": "v${version}"
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": {
        "name": "angular"
      },
      "infile": "CHANGELOG.md"
    }
  },
  "hooks": {
    "before:init": "pnpm --dir ../.. check",
    "after:bump": "node ../../scripts/pack-check.mjs --release"
  }
}
