# Check every text file out with LF on all platforms. Without this, Git on
# Windows checks out CRLF, and Prettier (whose default endOfLine is "lf")
# then reports every file in the repository as unformatted.
* text=auto eol=lf

# Shell scripts must keep LF even on Windows: CRLF breaks the shebang.
*.sh text eol=lf

# Binary files Git should never touch.
*.png binary
*.jpg binary
*.keystore binary
*.jks binary
*.tgz binary
