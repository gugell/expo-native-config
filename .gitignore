# Gradle output for app-owned native code that lives outside android/, whether
# it is a plain Gradle module (native/) or a local Expo module (modules/).
# These paths also break a Windows checkout: the dex filenames exceed MAX_PATH.
apps/*/native/**/build/
apps/*/native/**/.gradle/
apps/*/modules/**/build/
apps/*/modules/**/.gradle/
*.tsbuildinfo
